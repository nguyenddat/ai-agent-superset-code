# Copy to .env at the repository root and fill in. Compose fills docker-compose.yml with these values and loads
# them into the Superset containers. Commented lines show the default Compose uses when the variable is unset.

# Model for the AI Agent and the Semantic Layer's AI AutoFill (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Superset
# SUPERSET_PORT=8089
# SUPERSET_SECRET_KEY=local-development-secret-change-me
# SUPERSET_ADMIN_USERNAME=admin
# SUPERSET_ADMIN_PASSWORD=admin
# SUPERSET_ADMIN_FIRST_NAME=Superset
# SUPERSET_ADMIN_LAST_NAME=Admin
# SUPERSET_ADMIN_EMAIL=admin@example.com

# Superset metadata database
# SUPERSET_DB=superset
# SUPERSET_DB_USER=superset
# SUPERSET_DB_PASSWORD=superset_dev_password

# Analytics warehouse
# WAREHOUSE_DB=data_wh
# WAREHOUSE_DB_USER=bi
# WAREHOUSE_DB_PASSWORD=bi_dev_password
# WAREHOUSE_DB_PORT=5433
# WAREHOUSE_SUPERSET_NAME=Weather Warehouse

# Read-only login for the "Tổng quan AI Agent" dashboard
# TEXT_TO_BI_REPORTING_DB_PASSWORD=reporting_dev_password

# Airflow
# AIRFLOW_PORT=8080
# AIRFLOW_SECRET_KEY=local-airflow-secret-change-me
# AIRFLOW_ADMIN_USERNAME=admin
# AIRFLOW_ADMIN_PASSWORD=admin
# AIRFLOW_ADMIN_EMAIL=admin@example.com
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
